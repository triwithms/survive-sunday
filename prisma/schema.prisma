generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String?   @unique
  emailVerified  DateTime?
  name           String?
  passwordHash   String?
  image          String?
  phoneE164      String?   // SMS missing-pick reminders (+1XXXXXXXXXX)
  phoneSkippedAt DateTime? // soft-prompt skip; null = never asked
  /// email | sms | both | none. Channel for GAME notices. See notify-channels.ts.
  notifyPref     String    @default("none")
  createdAt      DateTime  @default(now())
  accounts       Account[]
  sessions       Session[]
  memberships    Membership[]
  poolAccessRoles PoolAccessRole[]
  auditLogs      AuditLog[] @relation("AuditActor")
  otpChallenges  OtpChallenge[]
  notificationPreference NotificationPreference?
  notificationSends      NotificationSend[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Hashed one-time codes (password reset). Plaintext is never stored.
model OtpChallenge {
  id          String    @id @default(cuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String
  purpose     String    // password_reset
  codeHash    String
  channel     String    // email | sms
  destination String
  expiresAt   DateTime
  attempts    Int       @default(0)
  consumedAt  DateTime?
  lastSentAt  DateTime
  createdAt   DateTime  @default(now())

  @@index([email, purpose, createdAt])
  @@index([userId, purpose, createdAt])
}

/// One-time personal invite. Store HMAC hash + expiry only — never plaintext.
model InviteToken {
  id           String      @id @default(cuid())
  tokenHash    String      @unique
  membershipId String
  membership   Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime    @default(now())

  @@index([membershipId])
}

model Pool {
  id          String       @id @default(cuid())
  name        String
  season      String
  inviteCode  String       @unique
  currentWeek Int          @default(1)
  /// demo = practise picker / demo copy. live = real private pool (no participant "demo" UX).
  mode        String       @default("demo") // demo | live
  /// null = classic one-mulligan season. N = from week N onward, one loss = out.
  singleEliminationFromWeek Int?
  /// Null = this pool owns its Game rows (the live family pool).
  /// Set = read NFL games and scores from that pool's weeks (same week number).
  /// Picks, locks, and memberships stay on this pool. Do not chain copies.
  slatePoolId String?
  createdAt   DateTime     @default(now())
  slatePool       Pool?            @relation("PoolSlate", fields: [slatePoolId], references: [id], onDelete: Restrict)
  slateFor        Pool[]           @relation("PoolSlate")
  memberships     Membership[]
  poolAccessRoles PoolAccessRole[]
  weeks           Week[]
  auditLogs       AuditLog[]
  weekWrapSetting WeekWrapSetting?
  poolInvites     PoolInvite[]

  @@index([slatePoolId])
}

/// Shared join link for one pool. Store the HMAC hash only.
/// Revoke or rotate from Admin. Plaintext exists only when minted.
model PoolInvite {
  id        String    @id @default(cuid())
  poolId    String
  tokenHash String    @unique
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  pool      Pool      @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@index([poolId, revokedAt])
}

model Membership {
  id                String           @id @default(cuid())
  poolId            String
  userId            String
  nickname          String
  realName          String?
  role              String           @default("member") // admin | member
  /// Denormalized mirror of PoolAccessRole administrator on this seat.
  /// Source of truth is PoolAccessRole. role=admin is still the spectator
  /// commissioner seat (not on the board).
  isAdmin           Boolean          @default(false)
  status            String           @default("undefeated") // undefeated | one_loss | eliminated
  mulliganRemaining Boolean          @default(true)
  /// false = spectator commissioner (not on the player board, no missed-pick losses)
  isParticipant     Boolean          @default(true)
  /// Skip missed-pick losses for weeks before this (spectator → player after transfer)
  playingFromWeek   Int?
  losses            Int              @default(0)
  weeksSurvived     Int              @default(0)
  usedTeamsJson     String           @default("[]") // JSON string[] of abbrs
  /// off | ranked. Default ranked. Leftover “mirror” reads as ranked.
  pickBackup        String           @default("ranked")
  /// Ranked leftover auto-picks (~5 min) this season. Official winner
  /// must stay 0. Manual / import never increment.
  autoPickStamps    Int              @default(0)
  /// Leftover copy-from pointer. Unused. Do not drop (shared Neon).
  mirrorFromMembershipId String?
  createdAt         DateTime         @default(now())
  pool              Pool             @relation(fields: [poolId], references: [id], onDelete: Cascade)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  picks             Pick[]
  inviteTokens      InviteToken[]
  mirrorFrom        Membership?      @relation("PickMirror", fields: [mirrorFromMembershipId], references: [id], onDelete: SetNull)
  mirroredBy        Membership[]     @relation("PickMirror")

  /// A user may hold the commissioner spectator seat and a player seat
  /// (e.g. Gams) in the same pool. Lookups use this index.
  @@index([poolId, userId])
  @@index([mirrorFromMembershipId])
  @@unique([poolId, nickname])
}
