# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LOCALE=en-CA
NEXT_PUBLIC_SEASON=2026/27

# Database — Neon Postgres (or any Postgres URL)
# Deploy path uses Neon; local SQLite file:./dev.db is no longer used.
# For local: use a Neon free DB, or a local Postgres URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Auth.js
# Default is localhost for QA. AUTH_TRUST_HOST=true + trustHost lets the
# incoming Host / x-forwarded-host / x-forwarded-proto win, so
# http://localhost:3000 and an https tunnel (trycloudflare / loca.lt)
# share one process. Middleware forwards Host as x-forwarded-host when
# it is not localhost. Cookies are Secure only on https.
# Tunnel-only users can pin:
#   AUTH_URL=https://your-subdomain.trycloudflare.com
#   AUTH_TRUST_HOST=false
# Production (Vercel): set AUTH_URL and NEXT_PUBLIC_APP_URL to the
# production URL, AUTH_TRUST_HOST=true, and a strong AUTH_SECRET.
AUTH_SECRET=generate-a-long-random-string
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Optional Google OAuth (demo works without these)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
