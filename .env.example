# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LOCALE=en-CA
NEXT_PUBLIC_SEASON=2026/27

# Database (SQLite — free local)
DATABASE_URL="file:./dev.db"

# Auth.js
# Default is localhost for QA. AUTH_TRUST_HOST=true lets the incoming
# Host / x-forwarded-proto win, so http://localhost:3000 and an https
# tunnel (e.g. https://great-sloths-fetch.loca.lt) share one process.
# Cookies are Secure only on https. Tunnel-only users can pin:
#   AUTH_URL=https://great-sloths-fetch.loca.lt
#   AUTH_TRUST_HOST=false
AUTH_SECRET=generate-a-long-random-string
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Optional Google OAuth (demo works without these)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
